# Copy these example values into Coolify's runtime environment.
# Do not commit real credentials or a real deployment environment file.

# Exact public HTTPS origin used for canonical metadata, sitemap, and JSON-LD.
SITE_URL=https://portfolio.example.com

# Production is indexable only when trusted ingress confirms SITE_URL.
SEO_DEPLOYMENT_ENV=production
SEO_TRUSTED_PROXY_ORIGIN=true

# Store the real value as a Coolify secret. Sending also requires
# about.contactEmail in portfolio.json and a verified Resend sender domain.
RESEND_API_KEY=replace-with-a-Coolify-secret

# Optional search-engine ownership verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
