# Resend API Key for sending emails
RESEND_API_KEY=re_123456789

# Canonical HTTPS origin. Required when SEO_DEPLOYMENT_ENV=production.
SITE_URL=

# Explicitly controls indexing: production is indexable; preview/local are not.
SEO_DEPLOYMENT_ENV=local

# Keep false unless trusted ingress overwrites X-SEO-Public-Origin and direct
# access to the application origin is blocked.
SEO_TRUSTED_PROXY_ORIGIN=false

# Optional ownership verification tokens from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
